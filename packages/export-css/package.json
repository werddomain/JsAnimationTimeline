{
  "name": "@werddomain/timeline-export-css",
  "version": "0.0.0",
  "private": true,
  "description": "Exports JsAnimationTimeline animations to pure CSS @keyframes.",
  "main": "dist/timeline-export-css.umd.js",
  "module": "dist/timeline-export-css.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/timeline-export-css.mjs",
      "require": "./dist/timeline-export-css.umd.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build --configLoader runner && tsc -p tsconfig.build.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@werddomain/timeline-runtime": "0.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/werddomain/JsAnimationTimeline.git",
    "directory": "packages/export-css"
  }
}
