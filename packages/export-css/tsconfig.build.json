{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "paths": {},
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./dist/types",
    "outDir": "./dist/types",
    "sourceMap": false,
    "inlineSources": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-demo", "src/**/__tests__/**", "src/**/*.test.ts", "src/**/*.spec.ts"]
}
