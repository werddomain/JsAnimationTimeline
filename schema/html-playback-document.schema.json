{
  "$comment": "schema/html-playback-document.schema.json — HA5 frame-sampled HTML playback; runtime additionally checks membership, frame coverage and budgets.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jstimeline.kazo.ca/schema/html-playback-document.schema.json",
  "title": "JsAnimationTimeline HTML playback document",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sampling", "source", "groups", "frames"],
  "properties": {
    "version": { "const": 1 },
    "sampling": { "const": "frames" },
    "source": { "$ref": "https://jstimeline.kazo.ca/schema/playback-document.schema.json" },
    "groups": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/group" } },
    "frames": {
      "type": "object", "minProperties": 1, "maxProperties": 100000,
      "propertyNames": { "pattern": "^[1-9][0-9]*$" },
      "additionalProperties": {
        "type": "object", "maxProperties": 10000,
        "propertyNames": { "pattern": "^group-[1-9][0-9]*$" },
        "additionalProperties": { "$ref": "#/$defs/declarations" }
      }
    }
  },
  "$defs": {
    "selector": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S" },
    "group": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "include", "exclude", "count"],
      "properties": {
        "id": { "type": "string", "pattern": "^group-[1-9][0-9]*$" },
        "include": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/selector" } },
        "exclude": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/selector" } },
        "count": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "declarations": {
      "type": "object",
      "propertyNames": { "pattern": "^(?:--|-?[a-zA-Z])[\\w-]*$", "not": { "enum": ["__proto__", "constructor", "prototype"] } },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 65536, "pattern": "^[^;{}]*$" }
    }
  }
}
