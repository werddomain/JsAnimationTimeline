{
  "version": "2.0.0",
  "settings": { "fps": 30, "totalFrames": 60 },
  "layers": [
    {
      "id": "scene",
      "type": "folder",
      "name": "Scene",
      "collapsed": false,
      "children": [
        {
          "id": "background",
          "type": "folder",
          "name": "Background",
          "color": "#2ECC71",
          "locked": true,
          "collapsed": true,
          "children": [
            {
              "id": "sky",
              "type": "layer",
              "name": "Sky",
              "icon": "https://example.com/icons/sky.svg",
              "target": { "selector": "#sky" },
              "spans": [
                {
                  "id": "sky-static",
                  "start": 1,
                  "end": 60,
                  "kind": "static",
                  "tracks": { "opacity": [ { "frame": 1, "value": 0.8 } ] }
                }
              ]
            }
          ]
        },
        {
          "id": "ball",
          "type": "layer",
          "name": "Ball",
          "icon": "icon-ball",
          "visible": false,
          "target": { "selector": "#ball" },
          "spans": [
            { "id": "ball-hidden", "start": 1, "end": 9, "kind": "blank" },
            {
              "id": "ball-bounce",
              "start": 10,
              "end": 40,
              "kind": "tween",
              "easing": "cubic-bezier(0.68, -0.55, 0.265, 1.55)",
              "tracks": {
                "y": [ { "frame": 10, "value": 0 }, { "frame": 25, "value": -120.5 }, { "frame": 40, "value": 0 } ],
                "scaleX": [ { "frame": 10, "value": 1 }, { "frame": 40, "value": 1.2 } ]
              }
            },
            { "id": "ball-rest", "start": 41, "end": 60, "kind": "static" }
          ]
        }
      ]
    },
    {
      "id": "empty-folder",
      "type": "folder",
      "name": "Empty folder",
      "children": []
    },
    {
      "id": "empty-layer",
      "type": "layer",
      "name": "Layer without spans",
      "spans": []
    }
  ]
}
