@* dotnet/samples/BlazorSample/Components/Pages/ScenePage.razor *@
@page "/scene"
<Navigation />
<main><h1>Scène C#</h1><p>La timeline calcule les valeurs ; un composant C# reçoit chaque image et dessine la scène.</p>
<SceneDisplay @ref="display" />
@if (stage is not null) { <TimelineEditor @bind-Data="document" Stage="stage" OnError="Error" /> }
<p role="alert">@error</p></main>
@code {
    private SceneDisplay display = default!;
    private TimelineStageOption? stage;
    private TimelineDocument document = SampleDocuments.Scene();
    private string error = "";
    protected override void OnAfterRender(bool firstRender) { if (firstRender) { stage = TimelineStageOption.DotNet(display); StateHasChanged(); } }
    private void Error(Exception value) => error = value.Message;
}
