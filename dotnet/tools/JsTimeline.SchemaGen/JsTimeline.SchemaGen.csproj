<Project Sdk="Microsoft.NET.Sdk">
  <!-- dotnet/tools/JsTimeline.SchemaGen : generates the C# model from schema/timeline.schema.json at build time. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="JsTimeline.Blazor.Tests" />
  </ItemGroup>
</Project>
