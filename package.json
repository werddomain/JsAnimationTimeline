{
  "name": "jsanimationtimeline",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo of the JsAnimationTimeline packages: runtime, editor and export-css.",
  "workspaces": [
    "packages/runtime",
    "packages/editor",
    "packages/export-css",
    "tools/conventions",
    "e2e"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:demo": "npm run build:demo --workspace packages/editor",
    "dev": "npm run dev --workspace packages/editor",
    "test": "npm test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test:e2e": "npm run e2e --workspace e2e"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/werddomain/JsAnimationTimeline.git"
  },
  "bugs": {
    "url": "https://github.com/werddomain/JsAnimationTimeline/issues"
  },
  "homepage": "https://github.com/werddomain/JsAnimationTimeline#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/jest": "^30.0.0",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "less": "^4.4.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
