{
  "name": "jsanimationtimeline",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo of the JsAnimationTimeline packages: runtime, editor and export-css.",
  "workspaces": [
    "packages/runtime",
    "packages/editor",
    "packages/export-css"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:dev": "npm run build:dev --workspace packages/editor",
    "dev": "npm run dev --workspace packages/editor",
    "watch": "npm run watch --workspace packages/editor",
    "test": "npm test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/werddomain/JsAnimationTimeline.git"
  },
  "bugs": {
    "url": "https://github.com/werddomain/JsAnimationTimeline/issues"
  },
  "homepage": "https://github.com/werddomain/JsAnimationTimeline#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "ajv": "^8.20.0",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.4",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "less": "^4.4.2",
    "less-loader": "^12.3.0",
    "mini-css-extract-plugin": "^2.9.4",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  }
}
